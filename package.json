{
  "name": "react-native-google-mobile-ads-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "React Native Google Mobile Ads monorepo",
  "repository": {
    "type": "git",
    "url": "https://github.com/invertase/react-native-google-mobile-ads"
  },
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "RNGoogleMobileAdsExample",
    "tooling/*"
  ],
  "scripts": {
    "postinstallDev": "yarn prepare",
    "prepare": "yarn lerna:prepare",
    "lerna:prepare": "cross-env NX_NO_CLOUD=true NX_CACHE_DIRECTORY=.nx/cache NX_WORKSPACE_DATA_DIRECTORY=.nx/workspace-data lerna run prepare",
    "build:all:clean": "lerna run build:clean",
    "build:all:build": "lerna run build",
    "lint:code": "yarn lint:js && yarn lint:android && yarn lint:ios:check",
    "lint:js": "eslint packages/core/src/ --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "lint:android": "(find packages/core/android/src -name '*.java' -not -path '*/generated/*' -print0 | xargs -0 google-java-format --set-exit-if-changed --replace || (echo \"\n\nandroid formatting error - please re-run\n\n\" && exit 1)) && (git diff --exit-code packages/core/android/src || (echo \"\n\nandroid files changed from linting, please examine and commit result\n\n\" && exit 1))",
    "lint:ios:check": "clang-format --glob=\"packages/core/ios/**/*.{h,cpp,m,mm}\" --style=Google -n -Werror",
    "lint:ios:fix": "clang-format -i --glob=\"packages/core/ios/**/*.{h,cpp,m,mm}\" --style=Google",
    "lint:markdown:check": "prettier --check \"docs/**/*.md[x]\"",
    "lint:markdown:fix": "prettier --write \"docs/**/*.md[x]\"",
    "lint:report": "eslint --output-file=eslint-report.json --format=json packages/core/src/ --ext .js,.jsx,.ts,.tsx",
    "lint:spellcheck": "spellchecker --quiet --files=\"docs/**/*.md[x]\" --dictionaries=\"./.spellcheck.dict.txt\" --reports=\"spelling.json\" --plugins spell indefinite-article repeated-words syntax-mentions syntax-urls frontmatter",
    "tsc:compile": "tsc --project packages/core/tsconfig.test.json",
    "lint": "yarn lint:code && yarn tsc:compile",
    "tests:jest": "jest",
    "tests:jest-watch": "jest --watch",
    "tests:jest-coverage": "jest --coverage",
    "tests:install": "yarn",
    "tests:packager": "yarn workspace RNGoogleMobileAdsExample react-native start",
    "tests:packager:reset-cache": "yarn workspace RNGoogleMobileAdsExample react-native start --reset-cache",
    "tests:e2e:codegen": "yarn workspace RNGoogleMobileAdsExample react-native codegen --platform all && node -e \"require('fs').rmSync('RNGoogleMobileAdsExample/android/app/build/generated/source/codegen', { recursive: true, force: true })\"",
    "tests:android:build": "yarn tests:e2e:codegen && cd RNGoogleMobileAdsExample/android && ./gradlew assembleDebug",
    "tests:android:build:windows": "yarn tests:e2e:codegen && cd RNGoogleMobileAdsExample/android && ./gradlew.bat assembleDebug",
    "tests:android:build-release": "yarn tests:e2e:codegen && cd RNGoogleMobileAdsExample/android && ./gradlew.bat assembleRelease",
    "tests:android:build-release:windows": "yarn tests:e2e:codegen && cd RNGoogleMobileAdsExample/android && ./gradlew.bat assembleRelease",
    "tests:android:run": "yarn tests:e2e:codegen && yarn workspace RNGoogleMobileAdsExample android",
    "tests:android:unit": "cd RNGoogleMobileAdsExample/android && ./gradlew :react-native-google-mobile-ads:testDebugUnitTest",
    "tests:ios:run": "yarn tests:e2e:codegen && yarn tests:ios:pod:install && yarn workspace RNGoogleMobileAdsExample react-native build-ios --buildFolder build && node ./scripts/run-ios-app.js",
    "tests:ios:pod:install": "bundle exec pod install --project-directory=RNGoogleMobileAdsExample/ios --repo-update",
    "release:refresh-ios-pod-lockfile": "node ./scripts/refresh-ios-pod-lockfile.js",
    "tests:ios:unit": "bash -c 'UDID=$(xcrun simctl list devices available | sed -n \"s/.*(\\([A-F0-9-]*\\)).*/\\1/p\" | head -1); test -n \"$UDID\" || { echo \"No available iOS Simulator\" >&2; exit 1; }; xcodebuild test -project packages/core/ios/RNGoogleMobileAdsUnitTests.xcodeproj -scheme RNGoogleMobileAdsUnitTests -destination \"id=$UDID\" CODE_SIGNING_ALLOWED=NO'",
    "tests:appium:validate": "yarn workspace @invertase/rngma-appium validate",
    "tests:appium:drivers:install": "yarn workspace @invertase/rngma-appium drivers:install",
    "tests:appium:drivers:verify": "yarn workspace @invertase/rngma-appium drivers:verify",
    "tests:appium:android": "yarn workspace @invertase/rngma-appium appium:android",
    "tests:appium:ios": "yarn workspace @invertase/rngma-appium appium:ios",
    "tests:appium:ios:select-and-boot": "yarn workspace @invertase/rngma-appium ios:select-and-boot",
    "tests:appium:ios:prebuild-wda": "yarn workspace @invertase/rngma-appium ios:prebuild-wda",
    "package:update": "yarn upgrade-interactive"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.38.0",
    "@react-native/babel-preset": "^0.83.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.0",
    "@semantic-release/npm": "^13.1.1",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "babel-jest": "^30.2.0",
    "clang-format": "1.8.0",
    "conventional-changelog": "^7.1.1",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-mocha": "^11.2.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "expo": "^54.0.18",
    "expo-module-scripts": "^5.0.7",
    "genversion": "^3.2.0",
    "globals": "^16.4.0",
    "google-java-format": "^2.0.4",
    "jest": "^30.2.0",
    "lerna": "^9.0.7",
    "nx": "^22.7.6",
    "prettier": "^3.6.2",
    "react": "^19.2.0",
    "react-native": "^0.83.1",
    "react-native-builder-bob": "^0.40.13",
    "react-native-test-app": "^5.0.10",
    "react-test-renderer": "^19.2.0",
    "rimraf": "^6.0.1",
    "semantic-release": "^25.0.1",
    "spellchecker-cli": "^7.0.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "yarn@4.10.3",
  "engines": {
    "node": ">=24"
  }
}
