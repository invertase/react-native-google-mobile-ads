ws_dir = Pathname.new(__dir__)
ws_dir = ws_dir.parent until
  File.exist?("#{ws_dir}/node_modules/react-native-test-app/test_app.rb") ||
  ws_dir.expand_path.to_s == '/'
require "#{ws_dir}/node_modules/react-native-test-app/test_app.rb"

# react-native-coverage CocoaPods helper (LLVM + CoverageConfig.h).
# Resolves via example node_modules (Pattern C — harness only). CocoaPods-first / static.
rn_coverage_post_install = Pod::Executable.execute_command('node', ['-p',
  'require("path").join(require.resolve("react-native-coverage/package.json", {paths:[process.argv[1]]}), "..", "cocoapods", "coverage_post_install.rb")',
  __dir__]).strip
require rn_coverage_post_install

workspace 'RNGoogleMobileAdsExample.xcworkspace'

use_test_app!(
  :hermes_enabled => true,
  :fabric_enabled => true,
  :ccache_enabled => true,
  :post_install => lambda { |installer|
    ReactNativeCoverage.apply_post_install!(
      installer,
      framework_name_prefixes: ['RNGoogleMobileAds'],
      # Character / RNTA are CocoaPods-static; do not force Coverage* dynamic.
      force_dynamic_frameworks: false,
      # Skip package app-target CFLAGS/SWIFT rewrites — those break RNTA Swift ↔
      # ReactTestApp-DevSupport ObjC interop. Library prefixes + Coverage pod still
      # get LLVM flags; we add app link flags below so Coverage.a profile symbols resolve.
      instrument_app: false
    )
    # App must link the LLVM profile runtime for Coverage flush symbols.
    installer.aggregate_targets.each do |aggregate_target|
      user_project = aggregate_target.user_project
      next if user_project.nil?

      user_project.native_targets.each do |target|
        target.build_configurations.each do |config|
          ld = config.build_settings['OTHER_LDFLAGS'] || '$(inherited)'
          next if ld.include?('-fprofile-instr-generate')

          config.build_settings['OTHER_LDFLAGS'] = [
            ld,
            '-fprofile-instr-generate',
            '-Wl,-u,___llvm_profile_set_filename',
          ].join(' ')
        end
      end
      user_project.save
    end
  }
)
