{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invertase.io/rngma/appium-drivers.manifest.schema.json",
  "title": "RNGMA Appium driver pin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["appiumHome", "appium", "drivers"],
  "properties": {
    "appiumHome": {
      "type": "string",
      "description": "Directory relative to tooling/appium used as APPIUM_HOME (gitignored install tree)."
    },
    "appium": {
      "type": "string",
      "description": "Pinned Appium server version; must match package.json dependencies.appium."
    },
    "drivers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "package", "version"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Appium driver short name (uiautomator2, xcuitest)."
          },
          "package": {
            "type": "string",
            "description": "npm package name for the driver."
          },
          "version": {
            "type": "string",
            "description": "Exact semver pin; must match package.json dependencies."
          }
        }
      }
    }
  }
}
