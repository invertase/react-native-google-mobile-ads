{
  "name": "@invertase/rngma-appium",
  "version": "0.0.0",
  "private": true,
  "description": "Appium 3 + WebdriverIO smoke harness for RNGoogleMobileAdsExample",
  "license": "Apache-2.0",
  "scripts": {
    "validate": "node ./scripts/validate-config.mjs && node --import tsx ./scripts/validate-specs.mjs && node --import tsx --test ./__tests__/*.test.ts",
    "packager": "tsx ./scripts/run-named.ts packager",
    "packager:reset-cache": "tsx ./scripts/run-named.ts packager --reset-cache",
    "android:build": "tsx ./scripts/run-named.ts android-build",
    "android:run": "tsx ./scripts/run-named.ts android-run",
    "ios:run": "tsx ./scripts/run-named.ts ios-run",
    "slot:guard": "tsx ./scripts/guard-slot.ts",
    "drivers:install": "node ./scripts/install-drivers.mjs",
    "drivers:verify": "node ./scripts/verify-drivers.mjs",
    "appium:android": "tsx ./scripts/preflight.ts android --run",
    "appium:ios": "tsx ./scripts/preflight.ts ios --run",
    "provision": "tsx ./scripts/provision.ts",
    "ios:select-and-boot": "tsx ./scripts/preflight.ts ios --select-and-boot",
    "ios:prebuild-wda": "tsx ./scripts/prebuild-wda.ts"
  },
  "dependencies": {
    "@wdio/appium-service": "9.31.3",
    "@wdio/cli": "9.31.3",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.31.3",
    "@wdio/logger": "9.29.1",
    "@wdio/mocha-framework": "9.31.2",
    "@wdio/spec-reporter": "9.31.2",
    "@wdio/types": "9.31.2",
    "appium": "3.7.0",
    "appium-uiautomator2-driver": "8.5.0",
    "appium-xcuitest-driver": "12.8.0",
    "expect-webdriverio": "6.0.9",
    "webdriverio": "9.31.3"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.9.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
