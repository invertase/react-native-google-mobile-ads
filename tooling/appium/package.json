{
  "name": "@invertase/rngma-appium",
  "version": "0.0.0",
  "private": true,
  "description": "Appium 4 + WebdriverIO 10 smoke harness for RNGoogleMobileAdsExample",
  "license": "Apache-2.0",
  "scripts": {
    "validate": "node ./scripts/validate-config.mjs && node --import tsx ./scripts/validate-specs.mjs && node --import tsx --test ./__tests__/*.test.ts",
    "packager": "tsx ./scripts/run-named.ts packager",
    "packager:reset-cache": "tsx ./scripts/run-named.ts packager --reset-cache",
    "android:build": "tsx ./scripts/run-named.ts android-build",
    "android:run": "tsx ./scripts/run-named.ts android-run",
    "ios:run": "tsx ./scripts/run-named.ts ios-run",
    "slot:guard": "tsx ./scripts/guard-slot.ts",
    "drivers:install": "node ./scripts/install-drivers.mjs",
    "drivers:verify": "node ./scripts/verify-drivers.mjs",
    "appium:android": "tsx ./scripts/preflight.ts android --run",
    "appium:ios": "tsx ./scripts/preflight.ts ios --run",
    "appium:parallel": "tsx ./scripts/parallel.ts both",
    "appium:android:parallel": "tsx ./scripts/parallel.ts android",
    "appium:android:parallel:external": "tsx ./scripts/parallel.ts android --metro=external",
    "appium:ios:parallel": "tsx ./scripts/parallel.ts ios",
    "appium:ios:parallel:external": "tsx ./scripts/parallel.ts ios --metro=external",
    "reliability": "tsx ./scripts/reliability-worker.ts",
    "reliability:campaign": "tsx ./scripts/reliability-campaign.ts",
    "reliability:operator-dashboard": "tsx ./scripts/refresh-operator-dashboard.ts",
    "check": "tsx ./scripts/check-resources.ts",
    "release": "tsx ./scripts/release-resources.ts",
    "force-acquire": "tsx ./scripts/force-acquire.ts",
    "provision": "tsx ./scripts/provision.ts",
    "ios:select-and-boot": "tsx ./scripts/preflight.ts ios --select-and-boot",
    "ios:prebuild-wda": "tsx ./scripts/prebuild-wda.ts"
  },
  "dependencies": {
    "@wdio/appium-service": "10.2.0",
    "@wdio/cli": "10.2.0",
    "@wdio/globals": "10.2.0",
    "@wdio/local-runner": "10.2.0",
    "@wdio/logger": "10.2.0",
    "@wdio/mocha-framework": "10.2.0",
    "@wdio/spec-reporter": "10.2.0",
    "@wdio/types": "10.2.0",
    "appium": "4.0.0",
    "appium-uiautomator2-driver": "9.2.2",
    "appium-xcuitest-driver": "13.1.3",
    "expect-webdriverio": "8.1.0",
    "webdriverio": "10.2.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.9.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
