{
  "name": "@react-native-google-mobile-ads/liveramp-ats",
  "version": "16.5.0",
  "private": true,
  "description": "LiveRamp Authenticated Traffic Solution (ATS) envelope manager and GMA Secure Signals RTB adapter for react-native-google-mobile-ads.",
  "author": "Invertase <oss@invertase.io> (http://invertase.io)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/invertase/react-native-google-mobile-ads",
    "directory": "packages/liveramp-ats"
  },
  "keywords": [
    "react-native",
    "google-mobile-ads",
    "liveramp",
    "ats",
    "secure-signals",
    "rtb"
  ],
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "react-native": "src/index.ts",
  "types": "lib/typescript/commonjs/index.d.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./src/index.ts"
      },
      "source": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./src/index.ts"
      },
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      },
      "default": "./lib/commonjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "/android/",
    "/ios/",
    "/lib/",
    "/src/",
    "/__fixtures__/",
    "/LICENSE",
    "/RNGoogleMobileAdsLiveRampAts.podspec",
    "/react-native.config.js"
  ],
  "secureSignals": {
    "provider": "liveramp-ats",
    "androidAdapterClassName": "io.invertase.googlemobileads.securesignals.liveramp.LiveRampAtsRtbAdapter",
    "iosAdapterClassName": "RNGMALiveRampAtsRtbAdapter",
    "envelopeApiVersion": "2.0.0"
  },
  "sdkVersions": {
    "android": {
      "minSdk": 23,
      "targetSdk": 34,
      "compileSdk": 34,
      "buildTools": "34.0.0"
    },
    "ios": {
      "minimumOsVersion": "12.0"
    }
  },
  "codegenConfig": {
    "name": "RNGMALiveRampAtsSpec",
    "type": "modules",
    "jsSrcsDir": "./src/specs",
    "android": {
      "javaPackageName": "io.invertase.googlemobileads.securesignals.liveramp"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      "typescript"
    ]
  },
  "scripts": {
    "prepare": "yarn build",
    "build": "bob build",
    "build:clean": "rimraf android/build && rimraf ios/build && rimraf lib",
    "test:android:unit": "cd android && ./gradlew testDebugUnitTest"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-google-mobile-ads": "*"
  },
  "devDependencies": {
    "react-native-builder-bob": "^0.40.13",
    "react-native-google-mobile-ads": "workspace:*",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  }
}
